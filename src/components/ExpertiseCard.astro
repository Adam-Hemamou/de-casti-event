---
// Carte d'expertise (pages Agence et DJ) : photo, titre, texte, bouton qui ouvre un pop-up.
// taille 'grande' : Agence (4 cartes) ; 'compacte' : DJ (5 cartes).
// Sans JavaScript, le bouton reste un lien vers l'ancre du pop-up.
import Photo from './Photo.astro';
import type { PhotoT } from '../data';

interface Props {
  title: string;
  text: string;
  note?: string;
  photo: PhotoT;
  link: string;
  popup: string;
  size?: 'grande' | 'compacte';
  /** false quand un conteneur (le carrousel) gère lui-même l'apparition au défilement. */
  reveal?: boolean;
}

const { title, text, note, photo, link, popup, size = 'grande', reveal = true } = Astro.props;
---

<article class:list={['card', `card--${size}`]} data-reveal={reveal ? '' : undefined}>
  <Photo
    photo={photo}
    class="card-photo"
    sizes={size === 'grande' ? '(max-width: 719px) 100vw, (max-width: 1023px) 50vw, 380px' : '(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 250px'}
    widths={[400, 700]}
  />
  <div class="body">
    <h3 class="bd it">{title}</h3>
    <p class:list={['p on text', { grow: !note }]}>{text}</p>
    {note && <p class="p on note">{note}</p>}
    <div class="foot">
      <a class="cta" href={`#${popup}`} data-popup-open={popup} aria-haspopup="dialog">
        <span>{link}</span>
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M1 5h15.5M12.5 1l4 4-4 4" />
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--card-dark);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 0 0 1px rgba(var(--highlight-rgb), 0.28);
  }
  .card :global(.card-photo) {
    width: 100%;
    height: 230px;
    flex: none;
  }
  .card--compacte :global(.card-photo) {
    height: 220px;
  }
  .body {
    padding: 26px 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }
  .card--compacte .body {
    padding: 22px 22px 18px;
  }
  h3 {
    margin: 0;
    font-size: 30px;
    line-height: 1.05;
    font-weight: 400;
    color: var(--highlight);
  }
  .card--compacte h3 {
    font-size: 26px;
  }
  .text {
    font-size: 15px;
  }
  .card--compacte .text {
    font-size: 14.5px;
  }
  .note {
    font-size: 15px;
    color: var(--muted-on-dark);
    flex-grow: 1;
  }
  .grow {
    flex-grow: 1;
  }
  .foot {
    margin-top: 6px;
    padding-top: 18px;
    border-top: 1px solid rgba(var(--highlight-rgb), 0.22);
  }
  .card--compacte .foot {
    padding-top: 16px;
  }

  /* Bouton d'ouverture du pop-up : pilule au contour doré, flèche qui avance au survol */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    padding: 0 18px 0 20px;
    border: 1px solid rgba(var(--highlight-rgb), 0.55);
    border-radius: 999px;
    color: var(--highlight);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease;
  }
  .cta svg {
    flex: none;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cta:hover {
    background: rgba(var(--highlight-rgb), 0.1);
    border-color: var(--highlight);
  }
  .cta:hover svg {
    transform: translateX(4px);
  }
  .cta:focus-visible {
    outline: 1px solid var(--highlight);
    outline-offset: 3px;
  }
  @media (max-width: 1180px) {
    .cta {
      gap: 10px;
      padding: 0 15px 0 17px;
      font-size: 13.5px;
      letter-spacing: 0.01em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta svg {
      transition: none;
    }
  }
</style>
