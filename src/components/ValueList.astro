---
// Liste titre + texte, séparés par des filets.
// layout 'grille' : 2 colonnes, titre en italique ; 'liste' : approche de la page DJ ;
// 'icones' : valeurs de l'accueil, 4 colonnes centrées avec icône et titre en capitales espacées.
import Icon, { type IconName } from './Icon.astro';

interface Props {
  items: { title: string; text: string; icon?: IconName }[];
  layout?: 'grille' | 'liste' | 'icones';
  class?: string;
}

const { items, layout = 'grille', class: extra } = Astro.props;
---

<div class:list={['values', `values--${layout}`, extra]}>
  {
    items.map((item) => (
      <div class="value" data-reveal>
        {layout === 'icones' && item.icon && <Icon name={item.icon} size={42} class="value-icon" />}
        <h3 class:list={layout === 'icones' ? 'caps' : 'bd it'}>{item.title}</h3>
        <p class="p">{item.text}</p>
      </div>
    ))
  }
</div>

<style>
  .values--grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    column-gap: 40px;
    row-gap: 8px;
    align-content: start;
  }
  .values--liste {
    display: flex;
    flex-direction: column;
  }
  .value {
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .values--liste .value {
    padding: 24px 0;
  }
  .values--liste .value:last-child {
    border-bottom: 1px solid var(--line);
  }
  h3 {
    margin: 0 0 10px;
    font-size: 26px;
    font-weight: 400;
  }
  .values--liste h3 {
    margin-bottom: 8px;
  }
  .p {
    font-size: 15px;
  }

  /* Icônes : 4 colonnes séparées par des filets verticaux */
  .values--icones {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .values--icones .value {
    padding: 6px 22px 4px;
    border-top: 0;
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .values--icones .value:first-child {
    border-left: 0;
  }
  .values--icones :global(.value-icon) {
    color: var(--accent);
    margin-bottom: 22px;
  }
  .caps {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.16em;
    text-wrap: balance;
    text-transform: uppercase;
    color: var(--wine);
  }
  .values--icones .p {
    max-width: 28ch;
  }

  @media (max-width: 1000px) {
    .values--icones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 48px;
    }
    .values--icones .value:nth-child(2n + 1) {
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .values--icones {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .values--icones .value {
      border-left: 0;
      padding: 32px 8px;
    }
    .values--icones .value + .value {
      border-top: 1px solid var(--line);
    }
    .values--icones .value:first-child {
      padding-top: 0;
    }
    .values--icones .value:last-child {
      padding-bottom: 0;
    }
  }
</style>
