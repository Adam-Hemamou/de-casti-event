---
// Bannière simple des pages secondaires (merci, 404, pages légales),
// dans le style des bannières du site : fond bordeaux, surtitre, grand titre Bodoni.
import Button from './Button.astro';
import { rich } from '../lib/rich';

interface Props {
  kicker: string;
  title: string;
  text?: string;
  cta?: { label: string; href: string };
}

const { kicker, title, text, cta } = Astro.props;
---

<div class="w intro">
  <p class="kick on" data-reveal>{kicker}</p>
  <h1 class="bd title" data-reveal-title set:html={rich(title)} />
  {text && <p class="p on lead" data-reveal>{text}</p>}
  {
    cta && (
      <div data-reveal>
        <Button href={cta.href}>{cta.label}</Button>
      </div>
    )
  }
</div>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 56px;
    padding-bottom: 104px;
  }
  .title {
    margin: 0;
    max-width: 14em;
    font-size: clamp(46px, 6.5vw, 78px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--bg-light);
  }
  .title :global(.it) {
    color: var(--highlight);
  }
  .lead {
    max-width: 48ch;
    font-size: 17px;
  }
  @media (max-width: 768px) {
    .intro {
      padding-top: 32px;
      padding-bottom: 72px;
    }
  }
</style>
