---
// Page 404 : servie avec le statut HTTP 404 (Vercel : route finale « /404.html », status 404).
// Composition : grand « 404 » doré dont le zéro est un disque vinyle (décor en CSS, sans
// lien avec le lecteur vinyle de l'accueil), puis titre, texte et liens vers l'accueil, la
// page DJ et le contact. Le disque tourne lentement, et reste immobile si l'utilisateur
// préfère réduire les animations. Page non indexée (noindex).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { pages } from '../data';
import { rich } from '../lib/rich';

const d = pages.erreur404;
---

<BaseLayout title={d.seo.title} description={d.seo.description} headerClass="hero-404" noindex>
  <div class="w err" slot="hero">
    <div class="digits" aria-hidden="true" data-reveal>
      <span class="digit bd">4</span>
      <span class="disc">
        <span class="disc-grooves"></span>
        <span class="disc-sheen"></span>
        <span class="disc-label"><span class="disc-hole"></span></span>
      </span>
      <span class="digit bd">4</span>
    </div>

    <div class="err-text">
      <h1 class="h1-group" style="--kick-gap: 18px">
        <span class="kick on" data-reveal>{d.kicker}</span>
        <span class="bd err-title" data-reveal-title set:html={rich(d.title)} />
      </h1>
      <p class="p on err-lead" data-reveal>{d.text}</p>
      <!-- Sans data-reveal : les boutons restent visibles d'emblée, même sur un écran peu haut. -->
      <div class="err-cta">
        <Button href={d.cta.href}>{d.cta.label}</Button>
        {d.links.map((l) => <Button variant="lien" on href={l.href}>{l.label}</Button>)}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Bannière pleine : fond noir avec halo doré discret derrière le chiffre. */
  :global(.site-header.hero-404) {
    background:
      radial-gradient(60% 55% at 50% 38%, rgba(var(--highlight-rgb), 0.1) 0%, transparent 70%),
      radial-gradient(120% 90% at 50% 0%, var(--velvet) 0%, var(--wine) 55%, var(--wine-deep) 100%);
    overflow: hidden;
  }

  .err {
    min-height: min(760px, calc(100svh - 110px));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    padding-top: 8px;
    padding-bottom: 96px;
    text-align: center;
  }

  /* « 4 ◉ 4 » (hauteur limitée pour que les boutons restent visibles sans défiler). */
  .digits {
    --size: clamp(140px, min(21vw, 34vh), 270px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.6vw, 22px);
    font-size: var(--size);
    line-height: 0.8;
  }
  .digit {
    background: linear-gradient(180deg, var(--highlight-hover) 0%, var(--highlight) 55%, rgba(var(--highlight-rgb), 0.55) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.02em;
  }

  /* Disque vinyle : sillons, reflet tournant, étiquette dorée. */
  .disc {
    position: relative;
    flex: none;
    width: 0.74em;
    height: 0.74em;
    border-radius: 50%;
    background: var(--wine-deep);
    box-shadow:
      0 0 0 1px rgba(var(--highlight-rgb), 0.35),
      0 30px 60px -20px rgba(var(--shadow-rgb), 0.9);
    animation: tourne 7s linear infinite;
  }
  .disc-grooves {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle at center,
      rgba(var(--highlight-rgb), 0.08) 0 1px,
      transparent 1px 4px
    );
  }
  .disc-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 20deg,
      transparent 0deg,
      rgba(var(--highlight-rgb), 0.22) 30deg,
      transparent 70deg,
      transparent 180deg,
      rgba(var(--highlight-rgb), 0.16) 210deg,
      transparent 250deg
    );
  }
  .disc-label {
    position: absolute;
    inset: 33%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--highlight-hover) 0%, var(--highlight) 45%, rgba(var(--highlight-rgb), 0.7) 100%);
    box-shadow: inset 0 0 0 2px rgba(var(--wine-rgb), 0.35);
  }
  .disc-hole {
    position: absolute;
    inset: 42%;
    border-radius: 50%;
    background: var(--wine-deep);
  }
  @keyframes tourne {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .disc {
      animation: none;
    }
  }

  /* Texte */
  .err-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 640px;
  }
  .err-title {
    display: block;
    margin: 0;
    font-size: clamp(40px, 5.2vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--bg-light);
  }
  .err-title :global(.it) {
    font-style: italic;
    color: var(--highlight);
  }
  .err-lead {
    max-width: 46ch;
    font-size: 17px;
  }
  .err-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    align-items: center;
    justify-content: center;
    padding-top: 6px;
  }

  @media (max-width: 768px) {
    .err {
      gap: 36px;
      padding-top: 24px;
      padding-bottom: 80px;
    }
    .err-cta {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
