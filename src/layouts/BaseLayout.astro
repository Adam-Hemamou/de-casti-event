---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '../styles/palettes.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { THEME } from '../config/theme';
import { site, type PageKey } from '../data';
import { photo } from '../lib/photos';
import { siteNodes, pageNodes, clean } from '../lib/structured-data';

// Polices affichées dès la bannière (logo, grands titres, navigation) : préchargées pour
// limiter le changement de police visible au chargement. Ce sont les mêmes fichiers que
// ceux des feuilles @fontsource importées ci-dessus (une seule URL, un seul téléchargement).
import bodoniNormal from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import bodoniItalic from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-italic.woff2?url';
import instrument400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Variante du pied de page (voir site.json > footer.variants). */
  footer?: PageKey;
  /** Classe ajoutée à l'en-tête, pour le style de la bannière propre à chaque page. */
  headerClass?: string;
  /** Bouton d'action de l'en-tête, si différent de celui par défaut. */
  headerCta?: { label: string; href: string };
  /** Photo de partage (nom de fichier dans src/assets/photos) et son texte alternatif. */
  ogImage?: { src: string; alt: string };
  /** Nom de la page dans le fil d'Ariane des données structurées (absent sur l'accueil). */
  breadcrumb?: string;
  /** Données structurées propres à la page (Service, FAQPage…), ajoutées au graphe commun. */
  schema?: Record<string, unknown>[];
  /** Destination du bouton flottant « Demander un devis » (mobile) ; absent = pas de bouton. */
  mobileCta?: string;
  noindex?: boolean;
}

const { title, description, footer = 'agence', headerClass, headerCta, ogImage, breadcrumb, schema = [], mobileCta, noindex = false } =
  Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site.url).href;
const ogPhoto = ogImage ?? { src: site.defaultOgImage, alt: site.defaultOgImageAlt };
const og = await getImage({ src: photo(ogPhoto.src), width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, site.url).href;
const ogWidth = og.attributes.width;
const ogHeight = og.attributes.height;

// Données structurées : un graphe par page (entreprise, Eva de Casti, site, page, fil d'Ariane,
// prestations). Les valeurs encore « à confirmer » ne sont pas publiées (voir lib/structured-data.ts).
// Pages non indexées (404, merci) : aucune donnée structurée.
let jsonLd: Record<string, unknown> | undefined;
if (!noindex) {
  const defaultOg =
    ogPhoto.src === site.defaultOgImage
      ? ogUrl
      : new URL((await getImage({ src: photo(site.defaultOgImage), width: 1200, format: 'jpg' })).src, site.url).href;
  const portrait = await getImage({ src: photo(site.person.photo), width: 800, format: 'jpg' });
  jsonLd = clean({
    '@context': 'https://schema.org',
    '@graph': [
      ...siteNodes({ organisation: defaultOg, person: new URL(portrait.src, site.url).href }),
      ...pageNodes({ url: canonical, title, description, breadcrumb }),
      ...schema,
    ],
  });
}
---

<!doctype html>
<html lang="fr" data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={bodoniItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodoniNormal} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrument400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    {ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    <meta property="og:image:alt" content={ogPhoto.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogPhoto.alt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Marque la présence de JavaScript (les styles « sans JS » restent la base). -->
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('js');
      });
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{site.skipLink}</a>
    <div class="site">
      <header class:list={['site-header', headerClass]}>
        <Header cta={headerCta} />
        <slot name="hero" />
      </header>
      <main id="contenu">
        <slot />
      </main>
      <Footer variant={footer} />
    </div>
    {mobileCta && <MobileCta href={mobileCta} />}
    <script>
      import '../scripts/animations';
      import '../scripts/popups';
      import '../scripts/card-carousel';
    </script>
  </body>
</html>

<style is:global>
  .site-header {
    position: relative;
    color: var(--bg-light);
  }
  html.menu-open {
    overflow: hidden;
  }

  /* Transition entre les pages : fondu doux. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.45s;
    animation-timing-function: ease;
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
